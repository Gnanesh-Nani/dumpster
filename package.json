    "commander": "^12.1.0",
    "figlet": "^1.11.4",
    "gradient-string": "^2.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.14.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
