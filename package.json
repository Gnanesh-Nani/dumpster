{
  "name": "dumpster-cli",
  "version": "2.1.6",
  "description": "Project-based MySQL dump/clone CLI — manage projects, servers, and databases, then dump or clone with a progress bar.",
  "bin": {
    "dumpster": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "overrides": {
    "mysql2": "^3.11.0"
  },
  "dependencies": {
